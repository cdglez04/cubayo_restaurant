# =========================================================
#  Cuba Yo — Variables de entorno (FRONTEND / Vite)
# =========================================================
# Copia este archivo a ".env" y rellena los valores reales.
# IMPORTANTE: en Vite SOLO las variables con prefijo VITE_ se
# exponen al navegador. NUNCA pongas secretos del backend
# (SECRET_KEY de Django, claves de Stripe privadas, etc.) aquí:
# todo lo que lleve VITE_ termina siendo público en el bundle.
# Los secretos reales viven en el backend (Django) en su propio .env.

# --- URL base del API (backend Django + JWT) ---
# En local suele ser http://127.0.0.1:8000/api
# En producción, el dominio del backend: https://api.cubayo.com
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# --- Rutas de autenticación JWT (SimpleJWT por defecto) ---
VITE_AUTH_LOGIN_PATH=/token/
VITE_AUTH_REFRESH_PATH=/token/refresh/

# --- Datos públicos del negocio (se pueden mover a backend luego) ---
VITE_BUSINESS_PHONE=+12817734124
VITE_WHATSAPP_NUMBER=12817734124

# --- Integraciones de terceros (claves PÚBLICAS únicamente) ---
# Ej: clave publishable de Stripe (pk_...), token público de mapa, etc.
VITE_MAPS_EMBED_KEY=
